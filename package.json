{
  "name": "departmental-inventory-checker",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "bootstrap:admin": "npm run bootstrap:admin --workspace server",
    "seed:demo": "npm run seed:demo --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
